# Optional. Without either of these set, every agent falls through to its
# deterministic fallback and the pipeline leans toward `unresolved` output
# instead of guessing. See skills/agent-architecture.
#
# Two providers are supported; ANTHROPIC_API_KEY takes priority if both are
# set. Pick one.
ANTHROPIC_API_KEY=
CODER_MODEL=claude-sonnet-4-5

GOOGLE_API_KEY=
CODER_MODEL_GOOGLE=gemini-2.5-flash
